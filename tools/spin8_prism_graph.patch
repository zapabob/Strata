diff --git a/src/llama-spin8.h b/src/llama-spin8.h
new file mode 100644
index 0000000000000000000000000000000000000000..a5b57b5174cc9fec7c67c2ba0aa91d898f02656c
--- /dev/null
+++ b/src/llama-spin8.h
@@ -0,0 +1,122 @@
+#pragma once
+#include "ggml.h"
+#include "spin8/spin8.h"
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <fstream>
+#include <memory>
+#include <mutex>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+// Reference graph adapter. K is rotated after cache read; this is not a rotated quantized cache.
+struct llama_spin8 {
+    std::array<std::array<float, 64>, 3> matrices{};
+    std::array<float, 3> weights{};
+    std::unique_ptr<spin8_plan, decltype(&spin8_plan_free)> plan{nullptr, spin8_plan_free};
+    mutable std::mutex mutex;
+    mutable spin8_monitor monitor{};
+    mutable uint64_t layer_tokens = 0;
+    const std::chrono::steady_clock::time_point epoch = std::chrono::steady_clock::now();
+
+    static std::shared_ptr<llama_spin8> load(int mode, const char * path) {
+        if (mode < 1 || mode > 4 || !path || !*path) {
+            throw std::runtime_error("Spin8 requires mode 1..4 and an explicit --spin8-profile");
+        }
+        std::ifstream input(path);
+        std::string line;
+        if (!std::getline(input, line) || line != "spin8-profile-v1") {
+            throw std::runtime_error("Spin8 profile: unreadable or unsupported version");
+        }
+        std::vector<spin8_plane> planes;
+        size_t bytes = 0;
+        while (std::getline(input, line)) {
+            bytes += line.size() + 1;
+            if (bytes > 65536 || planes.size() >= 4096) {
+                throw std::runtime_error("Spin8 profile exceeds size limit");
+            }
+            if (line.empty() || line[0] == '#') { continue; }
+            spin8_plane plane{};
+            std::string extra;
+            std::istringstream row(line);
+            if (!(row >> plane.a >> plane.b >> plane.angle) || (row >> extra)) {
+                throw std::runtime_error("Spin8 profile: invalid plane row");
+            }
+            planes.push_back(plane);
+        }
+        if (input.bad() || planes.empty()) { throw std::runtime_error("Spin8 profile is empty or unreadable"); }
+        auto cfg = std::make_shared<llama_spin8>();
+        spin8_plan * raw = nullptr;
+        if (spin8_plan_create(planes.data(), planes.size(), &raw) != SPIN8_OK) {
+            throw std::runtime_error("Spin8 profile: invalid Spin(8) lift");
+        }
+        cfg->plan.reset(raw);
+        for (int view = 0; view < 3; ++view) {
+            double matrix[64];
+            if (spin8_plan_matrix(raw, static_cast<spin8_view>(view), matrix) != SPIN8_OK) {
+                throw std::runtime_error("Spin8 matrix construction failed");
+            }
+            for (size_t i = 0; i < 64; ++i) { cfg->matrices[view][i] = static_cast<float>(matrix[i]); }
+            cfg->weights[view] = mode == 4 ? 1.0f/3.0f : (mode == view + 1 ? 1.0f : 0.0f);
+        }
+        spin8_monitor_init(&cfg->monitor);
+        cfg->audit(0);
+        return cfg;
+    }
+
+    void audit(uint64_t tokens) const {
+        std::lock_guard<std::mutex> lock(mutex);
+        layer_tokens += tokens;
+        const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - epoch).count();
+        int due = 0;
+        spin8_status status = spin8_monitor_due(&monitor, layer_tokens, seconds, &due);
+        if (status == SPIN8_OK && !due) { return; }
+        if (status != SPIN8_OK) { throw std::runtime_error("transform_invariant_violation: Spin8 invalidated"); }
+        spin8_audit_report strict{};
+        status = spin8_plan_audit(plan.get(), &strict);
+        for (int view = 0; view < 3 && status == SPIN8_OK; ++view) {
+            double deployed[64];
+            for (size_t i = 0; i < 64; ++i) { deployed[i] = matrices[view][i]; }
+            spin8_matrix_audit audit{};
+            status = spin8_audit_matrix(deployed, &audit);
+            if (status == SPIN8_OK && (audit.det_sign != 1 || audit.max_error > 1e-5 ||
+                audit.ef_normalized > 1e-5 || std::abs(audit.log_abs_det) > 8e-5)) { status = SPIN8_AUDIT_FAILED; }
+        }
+        spin8_monitor_record(&monitor, layer_tokens, seconds, status);
+        if (status != SPIN8_OK) { throw std::runtime_error("transform_invariant_violation: Spin8 audit failed"); }
+    }
+};
+
+inline ggml_tensor * llama_spin8_rotate(ggml_context * ctx, ggml_tensor * matrix, ggml_tensor * x) {
+    if (x->ne[0] < 8 || x->ne[0] % 8 != 0) {
+        throw std::runtime_error("Spin8 reference graph requires head dimension divisible by 8");
+    }
+    const auto cols = ggml_nelements(x)/8;
+    auto * blocks = ggml_reshape_2d(ctx, ggml_cont(ctx, ggml_cast(ctx, x, GGML_TYPE_F32)), 8, cols);
+    auto * rotated = ggml_mul_mat(ctx, matrix, blocks);
+    ggml_mul_mat_set_prec(rotated, GGML_PREC_F32);
+    return ggml_reshape_4d(ctx, rotated, x->ne[0], x->ne[1], x->ne[2], x->ne[3]);
+}
+
+inline ggml_tensor * llama_spin8_scores(ggml_context * ctx, ggml_tensor * q, ggml_tensor * k,
+        const std::array<ggml_tensor *, 3> & matrices, const std::array<float, 3> & weights) {
+    if (ggml_is_quantized(k->type) || q->ne[0] != k->ne[0]) {
+        throw std::runtime_error("Spin8 reference graph requires unquantized K with matching Q/K dimensions");
+    }
+    ggml_tensor * scores = nullptr;
+    for (int view = 0; view < 3; ++view) {
+        if (weights[view] == 0.0f) { continue; }
+        auto * qr = llama_spin8_rotate(ctx, matrices[view], q);
+        auto * kr = llama_spin8_rotate(ctx, matrices[view], k);
+        auto * term = ggml_mul_mat(ctx, kr, qr);
+        ggml_mul_mat_set_prec(term, GGML_PREC_F32);
+        term = ggml_scale(ctx, term, weights[view]);
+        scores = scores ? ggml_add(ctx, scores, term) : term;
+    }
+    if (!scores) { throw std::runtime_error("Spin8 reference graph has no active view"); }
+    ggml_set_name(scores, "spin8_reference_logits");
+    return scores;
+}
