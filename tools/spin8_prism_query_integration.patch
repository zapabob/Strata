diff --git a/ggml/src/ggml-cuda/spin8-bridge.cpp b/ggml/src/ggml-cuda/spin8-bridge.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..afe83e7d32899582553f8788d53dbe5aaf9be186
--- /dev/null
+++ b/ggml/src/ggml-cuda/spin8-bridge.cpp
@@ -0,0 +1,81 @@
+#include "../ggml-spin8.h"
+#include "spin8/query_v3_cuda.h"
+#include <cuda_runtime.h>
+#include <memory>
+
+namespace {
+struct device_state {
+    int device;
+    int * flag = nullptr;
+    spin8_query_v3_cuda_plan * plan = nullptr;
+};
+struct device_scope {
+    int previous = -1;
+    cudaError_t status;
+    explicit device_scope(int device) {
+        status = cudaGetDevice(&previous);
+        if (status == cudaSuccess) { status = cudaSetDevice(device); }
+    }
+    ~device_scope() { if (previous >= 0) { cudaSetDevice(previous); } }
+};
+int check_device(void * data) {
+    auto & state = *static_cast<device_state *>(data);
+    device_scope scope(state.device);
+    int flag = 0;
+    if (scope.status != cudaSuccess ||
+        cudaMemcpy(&flag, state.flag, sizeof(flag), cudaMemcpyDeviceToHost) != cudaSuccess) { return 4; }
+    return flag ? 2 : 0;
+}
+void free_device(void * data) {
+    auto * state = static_cast<device_state *>(data);
+    device_scope scope(state->device);
+    // Context has already synchronized all backend work before destruction.
+    if (scope.status == cudaSuccess && state->flag) { cudaFree(state->flag); }
+    spin8_query_v3_cuda_plan_free(state->plan);
+    delete state;
+}
+}
+
+// Compiled as ordinary C++ glue. The mathematical CUDA kernel is linked from
+// spin8_cuda, whose compilation is not subject to ggml-cuda fast-math flags.
+bool ggml_cuda_spin8_compute(ggml_tensor * dst, int device, cudaStream_t stream) noexcept {
+    auto * layer = ggml_spin8_match(dst);
+    if (!layer) { return false; }
+    auto * context = layer->state;
+    try {
+        if (!ggml_spin8_supported(dst)) { context->error.store(1); return true; }
+        if (context->error.load()) { return true; }
+        device_state * state = nullptr;
+        for (auto & entry : context->devices) {
+            if (entry.device == device) { state = static_cast<device_state *>(entry.data); break; }
+        }
+        if (!state) {
+            std::unique_ptr<device_state, decltype(&free_device)> owned(new device_state{device}, free_device);
+            int actual = -1;
+            if (cudaGetDevice(&actual) != cudaSuccess || actual != device ||
+                spin8_query_v3_cuda_plan_create(3, &owned->plan) != SPIN8_OK ||
+                cudaMalloc(&owned->flag, sizeof(int)) != cudaSuccess ||
+                cudaMemsetAsync(owned->flag, 0, sizeof(int), stream) != cudaSuccess) {
+                context->error.store(3); return true;
+            }
+            context->devices.push_back({device, owned.get(), check_device, free_device});
+            state = owned.release();
+        }
+        const auto * q = dst->src[0];
+        const auto * parameters = static_cast<const float *>(dst->src[1]->data);
+        const size_t width = layer->width, heads = layer->heads;
+        spin8_query_v3_cuda_bank_f32 bank{};
+        bank.version = 1; bank.heads = heads; bank.width = width;
+        bank.win = parameters; bank.win_bytes = heads*8*width*4; bank.win_head_stride_bytes = 8*width*4;
+        bank.bin = bank.win+heads*8*width; bank.bin_bytes = heads*8*4; bank.bin_head_stride_bytes = 8*4;
+        bank.wout = bank.bin+heads*8; bank.wout_bytes = heads*56*4; bank.wout_head_stride_bytes = 56*4;
+        bank.bout = bank.wout+heads*56; bank.bout_bytes = heads*7*4; bank.bout_head_stride_bytes = 7*4;
+        const auto error = spin8_query_v3_cuda_apply_batched_f32(state->plan, &bank,
+            static_cast<const float *>(q->data), ggml_nbytes(q), q->nb[1], q->nb[2],
+            static_cast<float *>(dst->data), ggml_nbytes(dst), dst->nb[1], dst->nb[2],
+            heads, size_t(q->ne[2]), width, state->flag, stream);
+        if (error != cudaSuccess) { context->error.store(3); }
+        else { context->cuda_calls.fetch_add(1); layer->cuda_calls.fetch_add(1); }
+    } catch (...) { context->error.store(5); }
+    return true;
+}
diff --git a/ggml/src/ggml-spin8.cpp b/ggml/src/ggml-spin8.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5f05df3477fdf507e796a50b2385829b2e6fcba4
--- /dev/null
+++ b/ggml/src/ggml-spin8.cpp
@@ -0,0 +1,100 @@
+#include "ggml-spin8.h"
+#include "ggml-impl.h"
+#include <cmath>
+#include <cstring>
+#include <stdexcept>
+
+static void spin8_cpu(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) nth;
+    if (ith != 0) { return; }
+    auto * layer = static_cast<ggml_spin8_layer *>(userdata);
+    auto * state = layer->state;
+    if (state->error.load()) { return; }
+    if (!ggml_spin8_supported(dst)) {
+        state->error.store(1);
+        return;
+    }
+    const auto * q = dst->src[0];
+    const auto * bank = dst->src[1];
+    const auto * weights = static_cast<const float *>(bank->data);
+    for (int64_t i = 0; i < ggml_nelements(bank); ++i) {
+        if (!std::isfinite(weights[i])) { state->error.store(2); return; }
+    }
+    for (size_t h = 0; h < layer->heads; ++h) {
+        const size_t src_offset = h * q->nb[1], dst_offset = h * dst->nb[1];
+        const auto status = spin8_query_v3_controller_apply(
+            layer->cpu[h], SPIN8_F32,
+            static_cast<const char *>(q->data) + src_offset, ggml_nbytes(q) - src_offset,
+            q->nb[2] / sizeof(float), static_cast<char *>(dst->data) + dst_offset,
+            ggml_nbytes(dst) - dst_offset, dst->nb[2] / sizeof(float), size_t(q->ne[2]));
+        if (status != SPIN8_OK) { state->error.store(100 + int(status)); return; }
+    }
+    state->cpu_calls.fetch_add(1);
+    layer->cpu_calls.fetch_add(1);
+}
+
+ggml_spin8_state * ggml_spin8_state_create() { return new ggml_spin8_state; }
+void ggml_spin8_state_free(ggml_spin8_state * state) {
+    if (!state) { return; }
+    for (auto & device : state->devices) { device.destroy(device.data); }
+    delete state;
+}
+int ggml_spin8_state_check(ggml_spin8_state * state) {
+    for (auto & device : state->devices) {
+        const int error = device.check(device.data);
+        if (error) { state->error.store(error); }
+    }
+    return state->error.load();
+}
+void ggml_spin8_layer_free(ggml_spin8_layer * layer) {
+    if (!layer) { return; }
+    for (auto * controller : layer->cpu) { spin8_query_v3_controller_free(controller); }
+    delete layer;
+}
+ggml_spin8_layer * ggml_spin8_layer_create(
+    ggml_spin8_state * state, const spin8_query_adapter_layer_view & view) {
+    std::unique_ptr<ggml_spin8_layer, decltype(&ggml_spin8_layer_free)> layer(
+        new ggml_spin8_layer{state, view.spec.head_width, view.spec.q_heads, {}}, ggml_spin8_layer_free);
+    const size_t width = layer->width;
+    layer->cpu.reserve(layer->heads);
+    for (size_t h = 0; h < layer->heads; ++h) {
+        std::vector<double> win(view.win + h * 8 * width, view.win + (h + 1) * 8 * width);
+        std::vector<double> bin(view.bin + h * 8, view.bin + (h + 1) * 8);
+        std::vector<double> wout(view.wout + h * 56, view.wout + (h + 1) * 56);
+        std::vector<double> bout(view.bout + h * 7, view.bout + (h + 1) * 7);
+        spin8_query_v3_controller * controller = nullptr;
+        if (spin8_query_v3_controller_create(3, width, win.data(), win.size()*8,
+                bin.data(), bin.size()*8, wout.data(), wout.size()*8, bout.data(), bout.size()*8,
+                &controller) != SPIN8_OK) {
+            throw std::runtime_error("transform_invariant_violation: cpu_controller_creation");
+        }
+        layer->cpu.push_back(controller);
+    }
+    return layer.release();
+}
+ggml_spin8_layer * ggml_spin8_match(const ggml_tensor * node) {
+    if (!node || node->op != GGML_OP_CUSTOM) { return nullptr; }
+    ggml_custom_op_params params;
+    memcpy(&params, node->op_params, sizeof(params));
+    return params.fun == spin8_cpu ? static_cast<ggml_spin8_layer *>(params.userdata) : nullptr;
+}
+bool ggml_spin8_supported(const ggml_tensor * node) {
+    const auto * layer = ggml_spin8_match(node);
+    if (!layer || !node->src[0] || !node->src[1]) { return false; }
+    const auto * q = node->src[0];
+    const auto * bank = node->src[1];
+    return q->type == GGML_TYPE_F32 && node->type == GGML_TYPE_F32 &&
+        bank->type == GGML_TYPE_F32 && ggml_is_contiguous(bank) &&
+        q->ne[0] == int64_t(layer->width) && q->ne[1] == int64_t(layer->heads) &&
+        q->ne[2] > 0 && q->ne[3] == 1 && ggml_are_same_shape(q, node) &&
+        q->nb[0] == 4 && q->nb[1] >= layer->width*4 &&
+        q->nb[2] >= (layer->heads-1)*q->nb[1]+layer->width*4 &&
+        q->nb[1]%4 == 0 && q->nb[2]%4 == 0 && ggml_is_contiguous(node) &&
+        ggml_nelements(bank) == int64_t(layer->heads*(8*layer->width+71));
+}
+ggml_tensor * ggml_spin8_query(
+    ggml_context * ctx, ggml_tensor * q, ggml_tensor * bank, ggml_spin8_layer * layer) {
+    ggml_tensor * args[] = {q, bank};
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, q->ne[0], q->ne[1], q->ne[2], 1,
+                         args, 2, spin8_cpu, 1, layer);
+}
