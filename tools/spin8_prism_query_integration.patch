+llama_spin8_query::llama_spin8_query(const llama_model & model, const llama_cparams & resolved,
+                                  const llama_context_params & params) {
+    require(model.arch == LLM_ARCH_QWEN35, "architecture_unsupported");
+    require(!model.spin8_model_digests.empty(), "model_not_hashed_by_loader");
+    require(params.ctx_other == nullptr && params.ctx_type == LLAMA_CONTEXT_TYPE_DEFAULT &&
+            params.n_rs_seq == 0, "shared_or_speculative_context_unsupported");
+    require(params.path_kv_mean_center == nullptr, "external_kv_bias_unsupported");
+    require(params.flash_attn_type != LLAMA_FLASH_ATTN_TYPE_AUTO, "explicit_flash_attention_required");
+    require(resolved.n_seq_max == 1, "multi_sequence_unsupported");
+    require(params.n_samplers == 0, "backend_sampler_unsupported");
+    require(model.n_devices() <= 1 && model.split_mode() != LLAMA_SPLIT_MODE_ROW, "multi_device_or_row_split_unsupported");
+    const auto & hp = model.hparams;
+    std::vector<spin8_query_adapter_layer_spec> specs;
+    for (uint32_t i = 0; i < hp.n_layer(); ++i) {
+        if (!hp.is_recr(i)) { specs.push_back({i, hp.n_head(i), hp.n_head_kv(i), hp.n_embd_head_k(i)}); }
+    }
+    require(!specs.empty(), "no_regular_attention_layers");
+    // Canonical v1: length-prefixed UTF8 labels, little-endian u32 and IEEE-F32
+    // bit patterns. No native struct padding, locale, path or sidecar fields.
+    std::vector<uint8_t> profile;
+    label(profile, "prism73bfe6cc-spin8-query-v3-profile-v1");
+    label(profile, "post-Qnorm-pre-MRoPE;rank8;rational-tau-tan-pi/8;positive-chirality;C(c)C(e0)^T;tail-identity;original-folded-Hadamard");
+    u32(profile, uint32_t(params.type_k)); u32(profile, uint32_t(params.type_v));
+    u32(profile, resolved.flash_attn); u32(profile, resolved.causal_attn);
+    u32(profile, resolved.kv_unified); u32(profile, params.swa_full);
+    u32(profile, hp.n_layer()); u32(profile, uint32_t(specs.size()));
+    f32(profile, hp.f_norm_rms_eps);
+    for (const auto & spec : specs) {
+        u32(profile, spec.layer_index); u32(profile, spec.q_heads); u32(profile, spec.kv_heads); u32(profile, spec.head_width);
+    }
+    std::vector<uint8_t> position;
+    label(position, "prism73bfe6cc-spin8-query-v3-position-v1");
+    u32(position, uint32_t(hp.rope_type)); u32(position, hp.n_rot());
+    u32(position, resolved.n_ctx); u32(position, resolved.n_ctx_seq); u32(position, resolved.n_ctx_orig_yarn);
+    for (int section : hp.rope_sections) { u32(position, uint32_t(section)); }
+    f32(position, resolved.rope_freq_base); f32(position, resolved.rope_freq_scale);
+    f32(position, resolved.yarn_ext_factor); f32(position, resolved.yarn_attn_factor);
+    f32(position, resolved.yarn_beta_fast); f32(position, resolved.yarn_beta_slow);
+    const auto profile_hash = digest(profile), position_hash = digest(position);
+    spin8_query_adapter_expectations expected{};
+    expected.abi_version = 1; expected.struct_bytes = sizeof(expected);
+    expected.model_count = uint32_t(model.spin8_model_digests.size()/32);
+    expected.model_digests = model.spin8_model_digests.data(); expected.model_digests_bytes = model.spin8_model_digests.size();
+    expected.layer_count = uint32_t(specs.size()); expected.layers = specs.data(); expected.layers_bytes = specs.size()*sizeof(specs[0]);
+    memcpy(expected.profile_digest, profile_hash.data(), 32); memcpy(expected.position_digest, position_hash.data(), 32);
+    std::ostringstream json;
+    json << "{\"schema\":1,\"models\":[";
+    for (uint32_t i = 0; i < expected.model_count; ++i) {
+        if (i) { json << ','; } json << '"' << hex(expected.model_digests+32*i, 32) << '"';
+    }
+    json << "],\"profile\":\"" << hex(profile_hash.data(),32) << "\",\"position\":\"" << hex(position_hash.data(),32)
+         << "\",\"profileEncodingHex\":\"" << hex(profile.data(),profile.size())
+         << "\",\"positionEncodingHex\":\"" << hex(position.data(),position.size()) << "\",\"layers\":[";
+    for (size_t i = 0; i < specs.size(); ++i) {
+        const auto & spec = specs[i]; if (i) { json << ','; }
+        json << "{\"layer_index\":" << spec.layer_index << ",\"q_heads\":" << spec.q_heads
+             << ",\"kv_heads\":" << spec.kv_heads << ",\"head_width\":" << spec.head_width << '}';
+    }
+    json << "]}"; bindings_json = json.str();
+    if (!params.spin8_query_sidecar) { return; } // inspection-only context
+    std::ifstream file(params.spin8_query_sidecar, std::ios::binary | std::ios::ate);
+    require(file.good(), "sidecar_open");
+    const auto length = file.tellg();
+    require(length > 0 && length <= SPIN8_QUERY_ADAPTER_MAX_BYTES, "sidecar_size");
+    std::vector<uint8_t> bytes(static_cast<size_t>(length)); file.seekg(0);
+    require(bool(file.read(reinterpret_cast<char *>(bytes.data()), length)), "sidecar_read");
+    spin8_query_adapter * loaded = nullptr;
+    const auto status = spin8_query_adapter_load(bytes.data(), bytes.size(), &expected, sizeof(expected), &loaded);
+    require(status == SPIN8_OK, "sidecar_binding_or_format"); adapter.reset(loaded);
+    spin8_query_adapter_info info{};
+    require(spin8_query_adapter_get_info(adapter.get(), &info, sizeof(info)) == SPIN8_OK, "sidecar_info");
+    label(provenance, "prism-query-v3-state-provenance-v1");
+    u32(provenance, expected.model_count);
+    provenance.insert(provenance.end(), model.spin8_model_digests.begin(), model.spin8_model_digests.end());
+    for (const auto * hash : {info.profile_digest, info.position_digest, info.convention_digest, info.content_digest}) {
+        provenance.insert(provenance.end(), hash, hash+32);
+    }
+    // CPU-backed immutable banks are real graph inputs, staged by GGML to the
+    // actual execution backend. Backend error flags are deliberately separate.
+    bank_ctx.reset(ggml_init({ggml_tensor_overhead()*specs.size(), nullptr, true}));
+    require(bank_ctx != nullptr, "bank_context_allocation");
+    for (uint32_t i = 0; i < specs.size(); ++i) {
+        spin8_query_adapter_layer_view view{};
+        require(spin8_query_adapter_get_layer(adapter.get(), i, &view, sizeof(view)) == SPIN8_OK, "sidecar_layer");
+        auto * bank = ggml_new_tensor_1d(bank_ctx.get(), GGML_TYPE_F32,
+            int64_t(view.spec.q_heads)*(8*view.spec.head_width+71));
+        ggml_format_name(bank, "spin8_bank_%u", view.spec.layer_index);
+        banks.emplace(int(view.spec.layer_index), bank);
+        layers.emplace(int(view.spec.layer_index), layer_ptr(ggml_spin8_layer_create(state.get(), view), ggml_spin8_layer_free));
+    }
+    bank_buffer.reset(ggml_backend_alloc_ctx_tensors_from_buft(bank_ctx.get(), ggml_backend_cpu_buffer_type()));
+    require(bank_buffer != nullptr, "bank_buffer_allocation");
+    // Keep ordinary input usage: marking this small bank as a CPU weight would
+    // override Q placement and silently schedule the custom operation on CPU.
+    for (uint32_t i = 0; i < specs.size(); ++i) {
+        spin8_query_adapter_layer_view view{};
+        require(spin8_query_adapter_get_layer(adapter.get(), i, &view, sizeof(view)) == SPIN8_OK, "sidecar_layer");
+        auto * bank = banks.at(int(view.spec.layer_index)); size_t offset = 0;
+        const float * arrays[] = {view.win, view.bin, view.wout, view.bout};
+        const size_t sizes[] = {view.win_bytes, view.bin_bytes, view.wout_bytes, view.bout_bytes};
+        for (size_t j = 0; j < 4; ++j) { ggml_backend_tensor_set(bank, arrays[j], offset, sizes[j]); offset += sizes[j]; }
+    }
+}
+ggml_tensor * llama_spin8_query::apply(ggml_context * ctx, ggml_tensor * q, int layer) {
+    require(!failed && active(), "context_unusable");
+    return ggml_spin8_query(ctx, q, banks.at(layer), layers.at(layer).get());
+}
+void llama_spin8_query::write_header(llama_io_write_i & io, uint32_t kind) const {
+    require(!failed, "context_unusable");
+    std::vector<uint8_t> header(magic, magic+8); u32(header, kind); u32(header, uint32_t(provenance.size()));
+    io.write(header.data(), header.size()); io.write(provenance.data(), provenance.size());
+}
+void llama_spin8_query::read_header(llama_io_read_i & io, uint32_t kind) {
+    require(!failed, "context_unusable");
+    std::vector<uint8_t> expected(magic, magic+8); u32(expected, kind); u32(expected, uint32_t(provenance.size()));
+    expected.insert(expected.end(), provenance.begin(), provenance.end());
+    std::vector<uint8_t> actual(expected.size()); io.read(actual.data(), actual.size());
+    require(actual == expected, "state_provenance_mismatch");
+}
+llama_spin8_prefix_reader::llama_spin8_prefix_reader(llama_io_read_i & input) : source(input) {
+    source.read(prefix.data(), prefix.size());
+}
+void llama_spin8_prefix_reader::read(void * dst, size_t size) {
+    const size_t take = std::min(size, prefix.size()-position);
+    memcpy(dst, prefix.data()+position, take); position += take;
+    if (size > take) { source.read(static_cast<uint8_t *>(dst)+take, size-take); }
+}
+void llama_spin8_prefix_reader::read_tensor(ggml_tensor * tensor, size_t offset, size_t size) {
+    require(position == prefix.size(), "state_prefix_unconsumed"); source.read_tensor(tensor, offset, size);
+}
+size_t llama_spin8_prefix_reader::n_bytes() { return source.n_bytes()-(prefix.size()-position); }
+bool llama_spin8_prefix_reader::enabled() const { return memcmp(prefix.data(), magic, 8) == 0; }
