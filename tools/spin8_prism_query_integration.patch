--- /dev/null
+++ b/src/llama-spin8.h
@@ -0,0 +1,47 @@
+#pragma once
+#include "ggml-spin8.h"
+#include "ggml-cpp.h"
+#include "llama.h"
+#include "llama-io.h"
+#include <array>
+#include <map>
+#include <string>
+
+struct llama_model;
+struct llama_model_loader;
+struct llama_cparams;
+void llama_spin8_hash_model(llama_model & model, llama_model_loader & loader);
+
+struct llama_spin8_query {
+    std::unique_ptr<spin8_query_adapter, decltype(&spin8_query_adapter_free)> adapter{nullptr, spin8_query_adapter_free};
+    std::unique_ptr<ggml_spin8_state, decltype(&ggml_spin8_state_free)> state{ggml_spin8_state_create(), ggml_spin8_state_free};
+    using layer_ptr = std::unique_ptr<ggml_spin8_layer, decltype(&ggml_spin8_layer_free)>;
+    std::map<int, layer_ptr> layers;
+    std::map<int, ggml_tensor *> banks;
+    ggml_context_ptr bank_ctx;
+    ggml_backend_buffer_ptr bank_buffer;
+    std::vector<uint8_t> provenance;
+    std::string bindings_json;
+    bool failed = false;
+
+    llama_spin8_query(const llama_model & model, const llama_cparams & resolved,
+                      const llama_context_params & params);
+    bool active() const { return adapter != nullptr; }
+    ggml_tensor * apply(ggml_context * ctx, ggml_tensor * q, int layer);
+    void write_header(llama_io_write_i & io, uint32_t kind) const;
+    void read_header(llama_io_read_i & io, uint32_t kind);
+};
+
+// Reads a discriminator before deserialization and replays it for legacy off
+// state. All readers, including file wrappers, retain their original bounds.
+class llama_spin8_prefix_reader : public llama_io_read_i {
+    llama_io_read_i & source;
+    std::array<uint8_t, 8> prefix{};
+    size_t position = 0;
+public:
+    explicit llama_spin8_prefix_reader(llama_io_read_i & source);
+    void read(void * dst, size_t size) override;
+    void read_tensor(ggml_tensor * tensor, size_t offset, size_t size) override;
+    size_t n_bytes() override;
+    bool enabled() const;
+};
