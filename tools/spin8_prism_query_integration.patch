@@ -0,0 +1,198 @@
+#include "llama-spin8.h"
+#include "llama-cparams.h"
+#include "llama-model.h"
+#include "llama-model-loader.h"
+#include "llama-mmap.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+extern "C" {
+#include "sha256.h"
+}
+
+namespace {
+constexpr uint8_t magic[8] = {'S','P','8','S','T','A','T','1'};
+void u32(std::vector<uint8_t> & out, uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i) { out.push_back(uint8_t(value >> (8*i))); }
+}
+void f32(std::vector<uint8_t> & out, float value) {
+    uint32_t bits; memcpy(&bits, &value, 4); u32(out, bits);
+}
+void label(std::vector<uint8_t> & out, const char * text) {
+    const auto size = strlen(text); u32(out, uint32_t(size)); out.insert(out.end(), text, text+size);
+}
+std::array<uint8_t,32> digest(const std::vector<uint8_t> & data) {
+    std::array<uint8_t,32> result{};
+    spin8_sidecar_sha256_hash(result.data(), data.data(), data.size()); return result;
+}
+std::string hex(const uint8_t * data, size_t size) {
+    constexpr char digits[] = "0123456789abcdef";
+    std::string out; out.reserve(2*size);
+    for (size_t i = 0; i < size; ++i) { out += digits[data[i]>>4]; out += digits[data[i]&15]; }
+    return out;
+}
+void require(bool condition, const char * reason) {
+    if (!condition) { throw std::runtime_error(std::string("transform_invariant_violation: ")+reason); }
+}
+}
+
+void llama_spin8_hash_model(llama_model & model, llama_model_loader & loader) {
+    require(!loader.files.empty() && loader.files.size() <= 256, "model_file_count");
+    // Windows has_direct_io() always returns true, including buffered fopen.
+    // Reject the actual selected loader mode, not that platform capability flag.
+    require(!loader.use_direct_io, "direct_io_hashing_unsupported");
+    std::vector<uint8_t> buffer(1024*1024);
+    for (auto & file : loader.files) {
+        const size_t saved = file->tell(), length = file->size();
+        spin8_sidecar_sha256_t hash; spin8_sidecar_sha256_init(&hash);
+        file->seek(0, SEEK_SET);
+        try {
+            for (size_t position = 0; position < length;) {
+                const size_t count = std::min(buffer.size(), length-position);
+                file->read_raw(buffer.data(), count);
+                spin8_sidecar_sha256_update(&hash, buffer.data(), count); position += count;
+            }
+            require(file->size() == length, "model_changed_during_hash");
+            file->seek(saved, SEEK_SET);
+        } catch (...) { file->seek(saved, SEEK_SET); throw; }
+        std::array<uint8_t,32> result{}; spin8_sidecar_sha256_final(&hash, result.data());
+        model.spin8_model_digests.insert(model.spin8_model_digests.end(), result.begin(), result.end());
+    }
+}
