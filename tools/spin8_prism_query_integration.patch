new file mode 100644
index 0000000000000000000000000000000000000000..4377503f35dfabafc98e120f2188fa4a3770547a
--- /dev/null
+++ b/ggml/src/ggml-spin8.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "ggml.h"
+#include "spin8/query_adapter.h"
+#include "spin8/query_v3.h"
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+// Private Prism bridge. Context operations are serialized by the caller.
+// Device callbacks belong to their backend DLL, which outlives this state.
+struct ggml_spin8_device {
+    int device;
+    void * data;
+    int (*check)(void *);
+    void (*destroy)(void *);
+};
+struct ggml_spin8_state {
+    std::atomic<int> error{0};
+    std::atomic<uint64_t> cpu_calls{0}, cuda_calls{0};
+    std::vector<ggml_spin8_device> devices;
+};
+struct ggml_spin8_layer {
