{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForkExtensionConfig",
  "description": "Schema for fork extensions (Spin(8), Triality, TurboQuant, Steering sidecars) in Strata",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "extension_id": { "type": "string" },
    "spin8": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["off", "cpu", "cuda", "triality_full"] },
        "native_config": { "type": ["string", "null"] },
        "native_sha256": { "type": ["string", "null"] }
      },
      "required": ["mode"]
    },
    "turboquant": {
      "type": "object",
      "properties": {
        "dialect": { "type": "string", "enum": ["standard", "tq4_1s", "tq3_0s", "pq2_0"] }
      }
    },
    "steering": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "profile": { "type": "string" },
        "vector_file": { "type": "string" },
        "strength": { "type": "number", "minimum": -5.0, "maximum": 5.0 }
      }
    }
  },
  "required": ["schema_version", "spin8"]
}
